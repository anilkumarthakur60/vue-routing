{
  "name": "@anil-labs/vue-routing",
  "version": "0.1.0",
  "type": "module",
  "description": "Laravel-inspired, fully-typed declarative routing for Vue 3 — a fluent wrapper over vue-router.",
  "keywords": [
    "vue",
    "vue-router",
    "router",
    "routing",
    "laravel",
    "typescript",
    "middleware"
  ],
  "license": "MIT",
  "author": "Anil Kumar Thakur (https://github.com/anilkumarthakur60)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/vue-routing.git"
  },
  "homepage": "https://github.com/anilkumarthakur60/vue-routing#readme",
  "bugs": {
    "url": "https://github.com/anilkumarthakur60/vue-routing/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "build:demo": "vue-tsc -b && vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.8"
  }
}
